{
  "name": "SVEA ESP32-C6 (ESP-IDF)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/workspaces/SVEA-PX4-MODULE-ENCODER",
  "customizations": {
    "vscode": {
      "settings": {
        "idf.showOnboardingOnInit": false,
        "idf.espIdfPath": "/opt/esp/idf",
        "idf.toolsPath": "/opt/esp",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh",
            "args": [
              "-l"
            ]
          },
          "bash": {
            "path": "/bin/bash",
            "args": [
              "-l"
            ]
          }
        }
      },
      "extensions": [
        "espressif.esp-idf-extension",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "openai.chatgpt"
      ]
    }
  },
  "runArgs": [
    "--init"
  ],
  "containerUser": "root",
  "postCreateCommand": "python3 -m pip install --break-system-packages esptool"
}